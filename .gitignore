# Data — never commit raw or final corpus TEXT. data/final/<dataset>/
# manifest.json (ids + stratification seed + source SHA-256, no text -- see
# pipeline/s2_prepare.py) is the one exception, so the split is reproducible
# without shipping text. NOTE: .gitignore has no inline comments; keep
# negations on their own line, and a negated path's parent directories must
# themselves be un-excluded too -- git will not descend into an excluded
# directory to find a negated file inside it.
data/*
!data/README.md
!data/final
data/final/*/*.csv
data/final/*/*/*.csv

results/
results.csv

# .smoke/ mirrors outputs/, data/final/, results/ for --limit (smoke) runs --
# see pipeline/_common.py::smoke_or_prod. Never tracked; a smoke run must
# never be able to write a production path.
.smoke/

# outputs/ is tracked (paper-facing Phase 2 material) -- nothing below
# excludes it; keep it that way.

# Model artefacts
*.pt
*.bin
*.safetensors
*.ckpt
*.onnx
*.h5
*.pkl

# Notebooks
.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
