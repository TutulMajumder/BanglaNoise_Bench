# Data and experiment outputs (added in later phases; never commit these).
# Use data/* (not data/) so the seeded split manifests can be re-included --
# git cannot un-exclude a path whose parent directory itself is excluded.
# NOTE: .gitignore has no inline comments; keep negations on their own line.
data/*
# ...except the prep code and the seeded split manifests, which ARE tracked
# (METHODOLOGY M2.2). Raw CSVs and data/clean/ stay ignored.
!data/*.py
!data/README.md
!data/splits
results/
results.csv

# Model artefacts
*.pt
*.bin
*.safetensors
*.ckpt
*.onnx
*.h5
*.pkl

# Notebooks
.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
